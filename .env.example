# ──────────────────────────────────────────────────────────────────
# config-mcp — Variables de entorno centralizadas (ejemplo)
# Copiar como .env y completar con valores reales
# ──────────────────────────────────────────────────────────────────

# ── Oracle DB ─────────────────────────────────────────────────────
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=host:puerto/SID

# ── Oracle DB Test ────────────────────────────────────────────────
ORACLE_TEST_USER=
ORACLE_TEST_PASSWORD=
ORACLE_TEST_CONNECT_STRING=host:puerto/SID

# ── Jira ──────────────────────────────────────────────────────────
JIRA_BASE_URL=https://tu-dominio.atlassian.net
JIRA_EMAIL=tu-email@example.com
JIRA_API_TOKEN=

# ── Tempo ─────────────────────────────────────────────────────────
TEMPO_API_TOKEN=

# ── GitLab ────────────────────────────────────────────────────────
GITLAB_BASE_URL=https://gitlab.tu-empresa.com
GITLAB_PERSONAL_ACCESS_TOKEN=

# ── MCP (compartido) ──────────────────────────────────────────────
MCP_LOG_LEVEL=info
MCP_PORT=3000
