{
  "name": "@config-mcp/oracle-db-test",
  "version": "1.0.0",
  "description": "MCP Server para Oracle DB de pruebas (consultas de solo lectura)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node scripts/check-no-focused-tests.js && node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit --detectOpenHandles",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "@config-mcp/mcp-core": "file:../../packages/mcp-core",
    "dotenv": "^16.4.7",
    "oracledb": "^6",
    "winston": "^3.17.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
